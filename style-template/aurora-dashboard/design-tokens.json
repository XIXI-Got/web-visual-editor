  "components": {
    "button": "10px / 7px 12px / radius 7px / 1px #28394B / #0B1522AA 底；hover 上浮 3px + 极光扫光 550ms",
    "panel": "radius 11px / 1px #1A2938 / linear-gradient(145deg,#08111B,#050B13 65%,#070E17)",
    "metricCard": "radius 7px / 1px #1B2A38 / 12px 10px 内边距 / sparkline 22px 高",
    "statCard": "radius 9px / #08111CDB + backdrop-blur 10px / 高 105px",
    "badge": "radius 20px / 3px 7px / 7px 字 / 1px 同色系描边",
    "input": "radius 5–6px / 1px #233242 / #080F18 底 / 8–10px 字",
    "navItem": "radius 7px / 9px 字 / active #111D2B + 1px #1B2B3B + 右移 2px"
  },
  "effects": {
    "aurora": "三层 radial-gradient 光带 + blur 22px + rotate(-9deg)，18s 漂移",
    "ribbon": "linear-gradient 斜向光带 + blur 15/26px + mix-blend-mode:screen，13s/17s 反向漂移",
    "edgeShimmer": "conic-gradient 描边（@property --aurora-spin）+ mask-composite:exclude，hover 4.8s 旋转",
    "grain": "radial-gradient 点阵 .7px / 38px 网格，opacity .24",
    "mountain": "clip-path polygon 山形 + 双层 linear-gradient",
    "lake": "repeating-linear-gradient 极光倒影"
  }
