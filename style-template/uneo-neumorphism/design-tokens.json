      "background": "#F6F3EE",
      "border": "1px solid rgba(226,221,212,0.55)",
      "shadow": "3px 3px 8px rgba(226,221,212,0.75), -3px -3px 8px rgba(255,255,255,0.9)"
    },
    "inset": {
      "background": "#EDE8E0",
      "border": "1px solid rgba(255,255,255,0.45)",
      "shadow": "inset 4px 4px 9px #E2DDD4, inset -4px -4px 9px #FFFFFF"
    },
    "espresso": {
      "background": "linear-gradient(145deg, #3D3024, #2B2118)",
      "border": "1px solid rgba(255,255,255,0.08)",
      "shadow": "7px 9px 18px rgba(51,40,30,0.26), -4px -4px 10px #FFFFFF",
      "hover": "linear-gradient(145deg, #47382A, #33281E)",
      "active": "scale(0.975) + inset 3px 3px 8px rgba(18,13,9,0.65)"
    },
    "grain": "radial-gradient(rgba(51,40,30,0.022) 1px, transparent 0)"
  },
  "components": {
    "dial": {
      "outerSize": "228px",
      "ring": "repeating conic ticks + bronze active arc #8C6F52",
      "wellSize": "166px",
      "wellBackground": "linear-gradient(145deg,#E8E2D9,#F5F2EC)",
      "wellShadow": "inset 10px 10px 22px #D5CFC4, inset -10px -10px 22px #FFFFFF, 6px 6px 16px rgba(226,221,212,0.6)",
