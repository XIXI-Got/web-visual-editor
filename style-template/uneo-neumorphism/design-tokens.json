      "capShadow": "12px 14px 26px rgba(182,173,160,0.65), -8px -8px 18px rgba(255,255,255,0.95), inset 1.5px 1.5px 3px rgba(255,255,255,0.9), inset -2px -2px 5px rgba(213,207,196,0.6)",
      "notch": "3.5 x 15px, right 16px, bronze-to-paper gradient",
      "readout": "9px sans, #8C6F52, subtle pill"
    },
    "buttonPrimary": {
      "height": "34–38px",
      "padding": "0 18–20px",
      "radius": "999px",
      "text": "11px / 500",
      "color": "#FAF8F5"
    },
    "buttonSecondary": {
      "height": "34–38px",
      "padding": "0 18–20px",
      "radius": "999px",
      "text": "11px / 500",
      "color": "#33281E"
    },
    "nav": {
      "height": "56px",
      "surface": "rgba(243,239,233,0.88)",
